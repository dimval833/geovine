---
// Διαβάζουμε τα αρχεία απευθείας από τον φάκελο content
const introFiles = Object.values(import.meta.glob('../content/intro.md', { eager: true }));
const intro = introFiles[0] as any;

const rocks = Object.values(import.meta.glob('../content/rocks/*.md', { eager: true })) as any[];
const problems = Object.values(import.meta.glob('../content/problems/*.md', { eager: true })) as any[];
const myths = Object.values(import.meta.glob('../content/myths/*.md', { eager: true })) as any[];
const galleryImages = Object.values(import.meta.glob('../gallery/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' })) as string[];
---

<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{intro.frontmatter.title}</title>
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6b233a;
            --primary-dark: #401c2b;
            --accent: #b77b45;
            --sage: #75856b;
            --bg: #f4f0e8;
            --text: #30302d;
            --card-bg: #ffffff;
        }
        html { scroll-behavior: smooth; overflow-x: hidden; }
        body {
            max-width: 100%;
            overflow-x: hidden;
            font-family: 'Manrope', sans-serif;
            background: var(--bg);
            background-image: linear-gradient(rgba(107,35,58,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(107,35,58,0.035) 1px, transparent 1px);
            background-size: 32px 32px;
            color: var(--text);
            line-height: 1.6;
            margin: 0;
            padding: 0;
        }
        h1, h2, h3 { font-family: 'Manrope', sans-serif; color: var(--primary); }
        h1 { font-size: clamp(2.35rem, 4.5vw, 4.2rem); line-height: 1.02; letter-spacing: -0.03em; }
        h2 { font-size: clamp(1.8rem, 3vw, 2.8rem); line-height: 1.1; }
       .site-header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 50;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: flex-end; 
            gap: 2rem;
            padding: 1rem 2rem;
            background: rgba(244,240,232,0.95);
            border-bottom: 1px solid rgba(107,35,58,0.12);
            backdrop-filter: blur(14px);
        }
        .menu-toggle { display: none; border: 1px solid rgba(107,35,58,0.2); border-radius: 8px; padding: 0.45rem 0.7rem; background: transparent; color: var(--primary); font: inherit; font-size: 0.8rem; font-weight: 800; }
        .brand { color: var(--primary); font-family: 'Manrope', sans-serif; font-size: 1.1rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
        .main-nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.35rem; }
        .main-nav a { color: var(--text); padding: 0.45rem 0.7rem; border-radius: 999px; font-size: 0.8rem; font-weight: 700; text-decoration: none; transition: color 0.2s, background 0.2s; }
        .main-nav a:hover, .main-nav a:focus-visible { color: white; background: var(--primary); }
        .container { box-sizing: border-box; width: 100%; max-width: 1200px; margin: 0 auto; padding: 3rem 2rem 0; }
        .intro-section { position: relative; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(220px, 0.6fr); gap: 4rem; align-items: end; margin-bottom: 7rem; padding: 5rem 0 3rem; }
        .intro-section::after { content: ''; position: absolute; right: 0; bottom: 0; width: 35%; height: 1px; background: var(--accent); }
        .eyebrow, .section-kicker { color: var(--accent); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
        .hero-note { border-left: 3px solid var(--accent); padding: 1rem 0 1rem 1.5rem; color: var(--primary-dark); font-size: 0.92rem; }
        .hero-note strong { display: block; margin-bottom: 0.6rem; color: var(--primary); font-family: 'Manrope', sans-serif; font-size: 1.35rem; }
        .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
        .section-heading h2 { margin: 0; }
        .section-heading p { max-width: 360px; margin: 0; color: #6a665f; font-size: 0.9rem; }
        .content-section { scroll-margin-top: 6rem; margin-bottom: 7rem; }


        .gallery-section { padding: 0 0 4rem; overflow: hidden; margin-bottom: 5rem; }
        .gallery-track { 
            display: flex; 
            gap: 1.5rem; 
            overflow-x: auto; 
            padding-bottom: 1.5rem; 
            scroll-snap-type: x mandatory;
            scrollbar-width: none; 
        }
        .gallery-track::-webkit-scrollbar { display: none; }
        .gallery-item {
            flex: 0 0 85%;
            max-width: 500px;
            scroll-snap-align: center;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0,0,0,0.06);
            margin: 0;
        }
        .gallery-item img {
            width: 100%;
            height: 350px;
            object-fit: cover;
            display: block;
        }
        @media (min-width: 900px) {
            .gallery-item { flex: 0 0 40%; }
        }


        .bento-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.5rem;
            margin-bottom: 4rem;
        }
        .text-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.5rem;
            margin-bottom: 4rem;
        }
        .text-card {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            aspect-ratio: 4/5;
            cursor: pointer;
            text-align: left;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .text-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }
        .text-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .text-card:hover img { transform: scale(1.05); }
        .text-card-copy {
            position: absolute;
            inset: auto 0 0;
            padding: 2.5rem 1.5rem 1.5rem;
            color: white;
            background: linear-gradient(to top, rgba(0,0,0,0.96) 0%, rgba(0,0,0,0.72) 48%, transparent 100%);
        }
        .text-card h3 { margin: 0; color: white; }
        .bento-card {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            cursor: pointer;
            aspect-ratio: 4/5; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.3s ease;
        }
        .bento-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }
        .bento-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .bento-card:hover img { transform: scale(1.05); }
        .bento-card-title {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.96) 0%, rgba(0,0,0,0.72) 48%, transparent 100%);
            color: white;
            padding: 2.5rem 1.5rem 1.5rem;
            margin: 0;
            font-size: 1.4rem;
        }

        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(4px);
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .modal-backdrop.active {
            opacity: 1;
            pointer-events: auto;
        }
        .modal-content {
            background: var(--card-bg);
            width: 90%;
            max-width: 600px;
            max-height: 85vh;
            overflow-y: auto;
            border-radius: 20px;
            padding: 2.5rem;
            position: relative;
            transform: translateY(50px) scale(0.95);
            transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .modal-image {
            display: block;
            width: calc(100% + 5rem);
            height: 220px;
            margin: -2.5rem -2.5rem 2rem;
            object-fit: cover;
        }
        .modal-backdrop.active .modal-content {
            transform: translateY(0) scale(1);
        }
        .close-btn {
            position: absolute;
            top: 15px;
            right: 20px;
            background: #eee;
            border: none;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }
        .close-btn:hover { background: #ddd; }
        
        .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
        .tag { background: #e9dce0; color: var(--primary); padding: 0.4rem 1rem; border-radius: 30px; font-size: 0.85rem; font-weight: 600; }
        .field-section { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: 3rem; padding: 3rem 0; border-top: 1px solid rgba(107,35,58,0.18); }
        .field-section h2 { margin-top: 0; }
        .field-section p { margin-top: 0; }
        .field-section a { color: var(--primary); font-weight: 800; }
        .feedback-form { margin-top: 2rem; padding: 1.5rem; background: rgba(255,255,255,0.72); border: 1px solid rgba(107,35,58,0.14); border-radius: 14px; }
        .feedback-intro { margin: 0 0 1.25rem; color: var(--primary-dark); font-family: 'Manrope', sans-serif; font-size: 1rem; font-weight: 700; }
        .feedback-form label, .feedback-form legend { display: block; margin-bottom: 0.45rem; color: var(--primary-dark); font-size: 0.85rem; font-weight: 800; }
        .feedback-form textarea, .feedback-form input { box-sizing: border-box; width: 100%; padding: 0.8rem 0.9rem; border: 1px solid #d8cfc6; border-radius: 8px; background: #fffdf9; color: var(--text); font: inherit; }
        .feedback-form textarea { min-height: 120px; resize: vertical; }
        .feedback-form textarea:focus, .feedback-form input:focus { outline: 2px solid var(--accent); outline-offset: 2px; border-color: var(--accent); }
        .feedback-field { margin-bottom: 1rem; }
        .feedback-optional { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .feedback-hint { margin: 0.35rem 0 0; color: #777168; font-size: 0.76rem; }
        .optional-note { color: #777168; font-size: 0.76rem; font-weight: 500; }
        .feedback-options { display: flex; flex-wrap: wrap; gap: 0.5rem; border: 0; padding: 0; margin: 0 0 1rem; }
        .feedback-options label { margin: 0; }
        .feedback-options input { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; opacity: 0; pointer-events: none; }
        .feedback-options span { display: block; padding: 0.45rem 0.7rem; border: 1px solid #d8cfc6; border-radius: 999px; background: #fffdf9; color: var(--text); font-size: 0.78rem; font-weight: 600; cursor: pointer; }
        .feedback-options input:checked + span { border-color: var(--primary); background: var(--primary); color: white; }
        .feedback-options .optional-note { display: inline; padding: 0; border: 0; border-radius: 0; background: transparent; color: #777168; cursor: default; }
        .feedback-submit { border: 0; border-radius: 999px; padding: 0.75rem 1.1rem; background: var(--primary); color: white; cursor: pointer; font: inherit; font-weight: 800; }
        .feedback-submit:hover { background: var(--primary-dark); }
        .feedback-status { margin: 0.7rem 0 0; color: var(--sage); font-size: 0.8rem; }
        .site-footer { display: flex; justify-content: space-between; gap: 2rem; padding: 2rem 0 3rem; border-top: 1px solid rgba(107,35,58,0.18); color: #716d65; font-size: 0.82rem; }
        .site-footer a { color: var(--primary); font-weight: 800; }

        @media (max-width: 900px) {
            .bento-grid, .text-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .intro-section { grid-template-columns: 1fr; gap: 1rem; }
        }

		@media (max-width: 900px) {
			.site-header { 
				position: fixed; 
				inset: 0 0 auto; 
				top: 0; 
				z-index: 50; 
				box-sizing: border-box; 
				width: 100%; 
				display: flex; 
				flex-wrap: wrap;
				align-items: center; 
				justify-content: flex-end; 
				gap: 0.65rem; 
				padding: 0.85rem 1rem; 
				background: rgba(244,240,232,0.95); 
			}
			.menu-toggle { 
				display: block; 
				position: static; 
			}
			.main-nav { 
				display: none; 
				width: 100%; 
				flex-direction: column; 
				align-items: stretch; 
				gap: 0.15rem; 
				padding-top: 0.35rem;
				max-height: calc(100vh - 70px);
				overflow-y: auto;
				padding-bottom: 1rem;
			}
			.main-nav.is-open { 
				display: flex; 
			}
			.main-nav a { 
				padding: 0.65rem 0.85rem; 
				border-radius: 7px; 
				font-size: 0.85rem; 
			}
			.container { padding: 5.5rem 1rem 0; }
			.intro-section { padding: 3rem 0 2rem; margin-bottom: 5rem; }
			.section-heading { display: block; }
			.section-heading p { margin-top: 0.7rem; }
			.field-section { grid-template-columns: 1fr; gap: 1rem; }
			.feedback-optional { grid-template-columns: 1fr; gap: 0; }
			.site-footer { display: block; }
			.site-footer span { display: block; margin-bottom: 0.5rem; }
			.bento-grid, .text-grid { grid-template-columns: 1fr; }
			.bento-card, .text-card { min-height: 420px; aspect-ratio: auto; }
			.modal-backdrop { align-items: center; justify-content: center; padding: 1rem; box-sizing: border-box; }
			.modal-content {
				width: 100%;
				box-sizing: border-box;
				max-height: 90vh;
				max-height: 90dvh;
				border-radius: 18px;
				transform: translateY(24px) scale(0.96);
				padding: 2rem 1.5rem;
			}
			.modal-image {
				width: calc(100% + 3rem);
				height: 180px;
				margin: -2rem -1.5rem 1.5rem;
			}
		}
    </style>
</head>
<body>
    <header class="site-header">
        <a href="#" style="margin-right: auto; display: flex; align-items: center;"><img src="paleo.png" alt="Λογότυπο" style="height: 42px; width: auto;" /></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">Μενού</button>
        <nav id="main-navigation" class="main-nav" aria-label="Κύρια sections">
            <a href="#intro">Εισαγωγή</a>
            <a href="#rocks">Πετρώματα</a>
            <a href="#problems">Προβλήματα</a>
            <a href="#myths">Μύθοι</a>
            <a href="#field-notes">Πεδίο</a>
            <a href="#bibliography">Βιβλιογραφία</a>
        </nav>
    </header>

    <main class="container">
        
        <section id="intro" class="intro-section">
            <div>
                <p class="eyebrow">Γεωλογία • Αμπελουργία • Μεσσηνία</p>
                <h1>{intro.frontmatter.title}</h1>
                <Fragment set:html={intro.compiledContent()} />
            </div>
            <aside class="hero-note">
                <strong>Το terroir αρχίζει κάτω από την επιφάνεια.</strong>
                Νερό, θερμοκρασία, κλίση και βάθος ρίζας αποκαλύπτουν τη συμπεριφορά κάθε αμπελώνα.
            </aside>
        </section>

        <section id="rocks" class="content-section">
            <div class="section-heading">
                <div><p class="section-kicker">01 / Ο οδηγός</p><h2>Τα Πετρώματα της Μεσσηνίας</h2></div>
                <p>Οκτώ γεωλογικοί σχηματισμοί και προτεινόμενες ποικιλίες.</p>
            </div>
        
            <div class="bento-grid">
                {rocks.map((rock: any, index: number) => {
                    const rockId = `rock-${index}`;
                    return (
                        <div class="bento-card" onclick={`openModal('${rockId}')`}>
                            <img src={rock.frontmatter.image} alt={rock.frontmatter.title} loading="lazy" />
                            <h3 class="bento-card-title">{rock.frontmatter.title}</h3>
                        </div>
                    );
                })}
            </div>
        </section>

        {rocks.map((rock: any, index: number) => {
            const rockId = `rock-${index}`;
            return (
                <div id={rockId} class="modal-backdrop" onclick={`closeModal('${rockId}')`}>
                    <div class="modal-content" onclick="event.stopPropagation()">
                        <button class="close-btn" onclick={`closeModal('${rockId}')`}>✕</button>
                        <img class="modal-image" src={rock.frontmatter.image} alt={rock.frontmatter.title} />
                        <h2 style="margin-top: 0;">{rock.frontmatter.title}</h2>
                        <div class="tags">
                            {rock.frontmatter.varieties?.map((v: string) => (
                                <span class="tag">{v}</span>
                            ))}
                        </div>
                        <Fragment set:html={rock.compiledContent()} />
                    </div>
                </div>
            );
        })}

        <section id="problems" class="content-section">
            <div class="section-heading">
                <div><p class="section-kicker">02 / Στο πεδίο</p><h2>Κρίσιμα Γεωλογικά Προβλήματα</h2></div>
                <p>Οι συνθήκες που δοκιμάζουν τη ρίζα, το έδαφος και τη διαχείριση του αμπελώνα.</p>
            </div>
            <div class="text-grid">
                {problems.map((problem: any, index: number) => {
                    const problemId = `problem-${index}`;
                    return (
                        <article class="text-card" onclick={`openModal('${problemId}')`}>
                            <img src={problem.frontmatter.image} alt={problem.frontmatter.title} loading="lazy" />
                            <div class="text-card-copy">
                                <h3>{problem.frontmatter.title}</h3>
                            </div>
                        </article>
                    );
                })}
            </div>
        </section>

        {problems.map((problem: any, index: number) => {
            const problemId = `problem-${index}`;
            return (
                <div id={problemId} class="modal-backdrop" onclick={`closeModal('${problemId}')`}>
                    <div class="modal-content" onclick="event.stopPropagation()">
                        <button class="close-btn" onclick={`closeModal('${problemId}')`}>✕</button>
                        <img class="modal-image" src={problem.frontmatter.image} alt={problem.frontmatter.title} />
                        <h2 style="margin-top: 0;">{problem.frontmatter.title}</h2>
                        <Fragment set:html={problem.compiledContent()} />
                    </div>
                </div>
            );
        })}

        <section id="myths" class="content-section">
            <div class="section-heading">
                <div><p class="section-kicker">03 / Η απομυθοποίηση</p><h2>Μύθοι και Αλήθειες</h2></div>
                <p>Τι δεν μεταφέρει ο βράχος στο ποτήρι και τι πραγματικά ρυθμίζει.</p>
            </div>
            <div class="text-grid">
                {myths.map((myth: any, index: number) => {
                    const mythId = `myth-${index}`;
                    return (
                        <article class="text-card" onclick={`openModal('${mythId}')`}>
                            <img src={myth.frontmatter.image} alt="Μύθος" loading="lazy" />
                            <div class="text-card-copy">
                                <h3>{myth.frontmatter.title}</h3>
                            </div>
                        </article>
                    );
                })}
            </div>
        </section>

        {myths.map((myth: any, index: number) => {
            const mythId = `myth-${index}`;
            return (
                <div id={mythId} class="modal-backdrop" onclick={`closeModal('${mythId}')`}>
                    <div class="modal-content" onclick="event.stopPropagation()">
                        <button class="close-btn" onclick={`closeModal('${mythId}')`}>✕</button>
                        <img class="modal-image" src={myth.frontmatter.image} alt="Μύθος" />
                        <h2 style="margin-top: 0;">{myth.frontmatter.title}</h2>
                        <p style="font-size: 1.15rem; font-style: italic; color: var(--primary); font-weight: 600; border-left: 3px solid var(--accent); padding-left: 1rem; margin-bottom: 1.5rem;">
                            <strong>Ο Μύθος:</strong> «{myth.frontmatter.quote}»
                        </p>
                        <Fragment set:html={myth.compiledContent()} />
                    </div>
                </div>
            );
        })}

        {galleryImages.length > 0 && (
        <section id="gallery" class="gallery-section">
            <div class="section-heading" style="padding: 0 2rem; max-width: 1200px; margin: 0 auto 2rem;">
                <div><p class="section-kicker">Εργαστήριο</p><h2>Η Έρευνα στο Πεδίο</h2></div>
                <p>Στιγμιότυπα από τις γεωλογικές αναλύσεις και τη χαρτογράφηση του Μεσσηνιακού αμπελώνα.</p>
            </div>
            
            <div class="gallery-track" style="padding-left: 2rem; padding-right: 2rem;">
                {galleryImages.map((fileName) => (
                    <figure class="gallery-item">
                        <img src={fileName} alt="Έρευνα Πεδίου" loading="lazy" />
                    </figure>
                ))}
            </div>
        </section>
        )}


        <section id="field-notes" class="field-section">
            <div>
                <p class="section-kicker">04 / Η ζωντανή γνώση</p>
                <h2>Συμπληρώνοντας τον Οδηγό</h2>
            </div>
            <div>
                <p>Η πραγματική γνώση για το Μεσσηνιακό Terroir δεν γράφεται μέσα στα εργαστήρια. Η γεωλογική έρευνα μας δίνει τα θεμέλια, αλλά η δική σας καθημερινή τριβή με το αμπέλι είναι αυτή που αποκαλύπτει τις λειτουργίες της φύσης. Αυτός ο ψηφιακός οδηγός σχεδιάστηκε με σκοπό να εμπλουτίζεται συνεχώς, και η δική σας εμπειρική γνώση είναι το πιο πολύτιμο κομμάτι του.</p>
                <form class="feedback-form" action="https://formspree.io/f/mrpzdkjg" method="POST">
                    <p class="feedback-intro">Μοιράσου τις παρατηρήσεις σου από τον αμπελώνα.</p>
                    <div class="feedback-field">
                        <label for="feedback-message"></label>
                        <textarea id="feedback-message" name="message" required placeholder="Π.χ. μετά τη βροχή το νερό λιμνάζει..."></textarea>
                        <p class="feedback-hint">Ένα-δύο συγκεκριμένα πράγματα αρκούν.</p>
                    </div>
                    <fieldset class="feedback-options">
                        <legend>Τι αφορά; <span class="optional-note">(προαιρετικό)</span></legend>
                        <label><input type="radio" name="topic" value="νερό" /><span>Νερό</span></label>
                        <label><input type="radio" name="topic" value="έδαφος" /><span>Έδαφος</span></label>
                        <label><input type="radio" name="topic" value="κλίση" /><span>Κλίση</span></label>
                        <label><input type="radio" name="topic" value="ποικιλία" /><span>Ποικιλία</span></label>
                    </fieldset>
                    <div class="feedback-optional">
                        <div class="feedback-field">
                            <label for="feedback-place">Περιοχή <span class="optional-note">(προαιρετικό)</span></label>
                            <input id="feedback-place" name="place" placeholder="π.χ. κοντά στη Φαρακλάδα" />
                        </div>
                        <div class="feedback-field">
                            <label for="feedback-email">Email <span class="optional-note">(προαιρετικό, μόνο για απάντηση)</span></label>
                            <input id="feedback-email" name="email" type="email" autocomplete="email" placeholder="name@example.com" />
                        </div>
                    </div>
                    <button class="feedback-submit" type="submit">Στείλε παρατήρηση</button>
                    <p class="feedback-status" aria-live="polite"></p>
                </form>
            </div>
        </section>

        <footer id="bibliography" class="site-footer">
            <span>Ο παρών οδηγός βασίζεται σε εκτεταμένη γεωλογική έρευνα πεδίου στην περιοχή της Μεσσηνίας, καθώς και στη μελέτη της διεθνούς βιβλιογραφίας για την αλληλεπίδραση γεωλογίας και αμπελουργίας.</span>
            <a href="#intro">Βιβλιογραφία &amp; Μεθοδολογία ↑</a>
        </footer>
    </main>

    <script is:inline>
        const menuToggle = document.querySelector('.menu-toggle');
        const mainNavigation = document.querySelector('.main-nav');
        menuToggle?.addEventListener('click', function() {
            const isOpen = mainNavigation?.classList.toggle('is-open') ?? false;
            menuToggle.setAttribute('aria-expanded', String(isOpen));
        });
        mainNavigation?.querySelectorAll('a').forEach(function(link) {
            link.addEventListener('click', function() {
                mainNavigation.classList.remove('is-open');
                menuToggle?.setAttribute('aria-expanded', 'false');
            });
        });

        function openModal(id) {
            const modal = document.getElementById(id);
            if(modal) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden'; 
            }
        }
        function closeModal(id) {
            const modal = document.getElementById(id);
            if(modal) {
                modal.classList.remove('active');
                document.body.style.overflow = ''; 
            }
        }
        document.addEventListener('keydown', function(event) {
            if (event.key === "Escape") {
                const activeModal = document.querySelector('.modal-backdrop.active');
                if (activeModal) activeModal.classList.remove('active');
                document.body.style.overflow = '';
            }
        });
    </script>
</body>
</html>